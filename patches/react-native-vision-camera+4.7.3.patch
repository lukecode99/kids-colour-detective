+//
+//  CameraView+AEWBLock.swift
+//  VisionCamera — CD-31 patch
+//
+
+import AVFoundation
+import Foundation
+
+extension CameraView {
+  func lockAEWB(promise: Promise) {
+    withPromise(promise) {
+      try self.cameraSession.lockAEWB()
+      return nil
+    }
+  }
+
+  func unlockAEWB(promise: Promise) {
+    withPromise(promise) {
+      try self.cameraSession.unlockAEWB()
+      return nil
+    }
+  }
+}
